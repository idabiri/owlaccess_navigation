# ---- dependencies and build output ----
node_modules/
app/dist/
dist/
*.tsbuildinfo
.vite/

# ---- runtime demo data: what people typed into the obstacle form during demos (recreated by the dev server) ----
app/data/obstacle_reports*.json
app/data/*.tmp

# ---- generated by test runs ----
tests/routing/results/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- secrets and local environment (none exist today; keep it that way) ----
.env
.env.*
.dev.vars
*.pem
*.key
.wrangler/

# ---- third-party maps: Kennesaw State University publications, no redistribution licence found ----
# Kept locally for reference. Only remove this line with KSU's permission (and then consider Git LFS, see .gitattributes).
data/reference/ksu_maps/

# ---- QGIS temporary files ----
*.qgs~
*.qgz~
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal

# ---- archives and backups (the project's own backups live outside the repository) ----
*.zip
*.bak
*.backup-*

# ---- editors, OS, logs, local tools ----
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
